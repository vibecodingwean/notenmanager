<?xml version="1.0" encoding="utf-8"?>
<!-- Fill the launcher mask; preserve the central finger/siren motif without extra framing. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="10%" android:insetTop="10%"
    android:insetRight="10%" android:insetBottom="10%">
    <bitmap android:src="@drawable/streberalarm_artwork"
        android:gravity="fill" android:filter="true" android:antialias="true" />
</inset>
